# Syntax: docker/dockerfile:1
FROM node:22-alpine AS builder

WORKDIR /app

# Copy root package files and mcp-doc-retrieval
COPY package*.json ./
COPY mcp-servers/doc-retrieval/package*.json ./mcp-servers/doc-retrieval/

RUN npm install --workspace=@insightforge/mcp-doc-retrieval

COPY mcp-servers/doc-retrieval/ ./mcp-servers/doc-retrieval/

WORKDIR /app/mcp-servers/doc-retrieval
RUN npm run build

# Production Runner
FROM node:22-alpine AS runner

WORKDIR /app

RUN apk add --no-cache curl

ENV NODE_ENV=production
ENV PORT=4002

COPY package*.json ./
COPY mcp-servers/doc-retrieval/package*.json ./mcp-servers/doc-retrieval/

RUN npm install --omit=dev --workspace=@insightforge/mcp-doc-retrieval

COPY --from=builder /app/mcp-servers/doc-retrieval/dist ./mcp-servers/doc-retrieval/dist

EXPOSE 4002

CMD ["node", "mcp-servers/doc-retrieval/dist/index.js"]
