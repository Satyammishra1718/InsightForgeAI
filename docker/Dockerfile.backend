# Syntax: docker/dockerfile:1
# Debian (glibc) rather than Alpine: onnxruntime-node, used for the local MiniLM
# embedding model, ships no prebuilt binaries for Alpine's musl libc.
FROM node:22-bookworm-slim AS builder

WORKDIR /app

# Copy root package files and backend
COPY package*.json ./
COPY backend/package*.json ./backend/

RUN npm install --workspace=backend

COPY backend/ ./backend/

WORKDIR /app/backend
RUN npm run build

# Production Runner
FROM node:22-bookworm-slim AS runner

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl \n    && rm -rf /var/lib/apt/lists/*

ENV NODE_ENV=production
# Local embedding model weights are downloaded here on first use (mount a volume to persist)
ENV EMBEDDING_CACHE_DIR=/app/data/models

COPY package*.json ./
COPY backend/package*.json ./backend/

RUN npm install --omit=dev --workspace=backend

COPY --from=builder /app/backend/dist ./backend/dist

EXPOSE 5000 5001

CMD ["node", "backend/dist/index.js"]
