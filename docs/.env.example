# ===================================================
# InsightForge-AI Environment Configuration
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:5000
VITE_WS_BASE_URL=ws://localhost:5001

# Databases & Cache
MONGODB_URI=mongodb://localhost:27017/insightforge
# Set to 'true' to use a local embedded MongoDB instead of MONGODB_URI (no install needed).
# It is also the automatic fallback when MONGODB_URI is unreachable.
FORCE_LOCAL_DB=false
# Where the embedded MongoDB keeps its data, so research history survives restarts
MONGODB_DATA_DIR=data/mongo
# Set to 'true' to load illustrative demo sessions into an empty database (not real pipeline output)
SEED_DEMO_DATA=false
REDIS_URL=redis://localhost:6379
# ChromaDB vector database (server). The backend auto-starts a local server from
# agent-service/venv if none is running at CHROMA_URL (see "npm run setup:python").
CHROMA_URL=http://127.0.0.1:8001
CHROMA_DATA_DIR=./data/chroma

# LLM Providers (Provide at least one)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
