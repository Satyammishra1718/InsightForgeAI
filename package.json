{
  "name": "insightforge-ai",
  "version": "0.1.0",
  "private": true,
  "description": "InsightForge-AI: Full-Stack Agentic AI Research Platform",
  "workspaces": [
    "backend",
    "frontend",
    "mcp-servers/web-search",
    "mcp-servers/doc-retrieval"
  ],
  "scripts": {
    "setup:python": "node scripts/venv.mjs setup",
    "dev": "concurrently -k -n \"chroma,agent,mcp-web,mcp-doc,backend,frontend\" -c \"magenta,yellow,cyan,cyan,blue,green\" \"npm:chroma\" \"npm:dev:agent\" \"npm:dev:mcp-web\" \"npm:dev:mcp-doc\" \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "npm run dev -w backend",
    "dev:frontend": "npm run dev -w frontend",
    "dev:agent": "node scripts/venv.mjs --cwd agent-service python -m uvicorn app.main:app --reload --port 8000",
    "dev:mcp-web": "npm run dev -w mcp-servers/web-search",
    "dev:mcp-doc": "npm run dev -w mcp-servers/doc-retrieval",
    "chroma": "node scripts/venv.mjs chroma run --path data/chroma --host 127.0.0.1 --port 8001",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,css,md}\"",
    "seed": "npm run seed -w backend",
    "test:api": "npm run test:api -w backend",
    "test:rag": "npm run test:rag -w backend",
    "inspect:db": "npm run inspect:db -w backend"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.5.3"
  }
}
