# ==============================================================================
# InsightForge-AI Root Environment Variables (.env)
# Copy this file to .env before starting services or running docker compose up.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Node.js Express Backend & WebSocket Gateway
# ------------------------------------------------------------------------------
PORT=5000
WS_PORT=5001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info

# Set to 'false' in production or docker-compose to use the dedicated worker container
RUN_EMBEDDED_WORKER=true

# ------------------------------------------------------------------------------
# 2. Database & In-Memory Cache
# ------------------------------------------------------------------------------
# MongoDB connection string (Atlas or local container)
# Local docker-compose default: mongodb://mongo:27017/insightforge
# Local dev default: mongodb://127.0.0.1:27017/insightforge
MONGODB_URI=mongodb://127.0.0.1:27017/insightforge

# Set to 'true' to instantly use local in-memory MongoDB without probing Atlas (e.g. firewalled networks)
FORCE_LOCAL_DB=false

# Redis connection string (used by BullMQ, Redis Pub/Sub, and Semantic Cache)
# Local docker-compose default: redis://redis:6379
# Local dev default: redis://127.0.0.1:6380
REDIS_URL=redis://127.0.0.1:6380

# ------------------------------------------------------------------------------
# 3. Python FastAPI LangGraph Microservice (/agent-service)
# ------------------------------------------------------------------------------
AGENT_SERVICE_URL=http://127.0.0.1:8000
AGENT_SERVICE_PORT=8000
AGENT_SERVICE_HOST=0.0.0.0
BACKEND_URL=http://127.0.0.1:5000

# Primary LLM Provider: Groq (ultra-fast inference with Llama 3.3 70B)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_here
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.3-70b-versatile
# Embeddings: 'local' (default) runs all-MiniLM-L6-v2 in-process (384-dim, no API key;
# ~90MB downloaded once into EMBEDDING_CACHE_DIR). 'openai' uses text-embedding-3-small (1536-dim).
EMBEDDING_PROVIDER=local
# EMBEDDING_CACHE_DIR=./data/models
# Set to true ONLY for offline demos: agents return canned output when no LLM key is set
ALLOW_MOCK_LLM=false

# Optional Alternative LLM Providers (OpenAI / Anthropic / Local Ollama)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ------------------------------------------------------------------------------
# 4. Model Context Protocol (MCP) Tool Servers
# ------------------------------------------------------------------------------
# MCP Web Search Server
MCP_WEB_SEARCH_PORT=4001
MCP_WEB_SEARCH_URL=http://127.0.0.1:4001/sse
TAVILY_API_KEY=your_tavily_api_key_here
SERPER_API_KEY=

# MCP Document Retrieval (RAG) Server
MCP_DOC_RETRIEVAL_PORT=4002
MCP_DOC_RETRIEVAL_URL=http://127.0.0.1:4002/sse
VECTOR_DB_PATH=./data/vector_db

# ------------------------------------------------------------------------------
# 5. BullMQ Research Worker
# ------------------------------------------------------------------------------
WORKER_CONCURRENCY=3

# ------------------------------------------------------------------------------
# 6. Frontend Configuration (/frontend)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=http://localhost:5000
VITE_WS_URL=ws://localhost:5000/ws
